{
  "name": "fitposture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --experimental-sqlite server/index.ts",
    "dev:all": "node scripts/05-dev-all.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "types:offline": "node scripts/20-offline-install.mjs @types/express@^5 @types/cors@^2 @types/jsonwebtoken @types/node@^22",
    "api:test": "node .scripts/32-api-e2e.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "assets:fetch": "node scripts/01-fetch-assets.mjs",
    "assets:optimize": "node scripts/02-optimize-glb.mjs",
    "assets:manifest": "node scripts/03-gen-manifest.mjs",
    "assets:map": "node scripts/04-build-group-map.mjs",
    "assets:all": "npm run assets:fetch && npm run assets:optimize && npm run assets:manifest && npm run assets:map"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.102.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "three": "^0.186.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "draco3dgltf": "^1.5.7",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
